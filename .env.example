# Runtime
NODE_ENV=development
PORT=3000

# MongoDB connection (no hardcoded fallback; required at startup)
MONGODB_URI=mongodb://localhost:27017/cron-job_practice
MONGODB_POOL_SIZE=10
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# TLS (certificate validation is always enforced)
MONGODB_TLS=false
# MONGODB_TLS_CA_FILE=/path/to/ca.pem

# Cron (default: every minute at second 0, UTC)
CRON_SCHEDULE=0 * * * * *
CRON_TIMEZONE=UTC
CRON_LOCK_TTL_SECONDS=30

# CORS allowlist (comma separated). Must not be "*" in production.
CORS_ORIGIN=*
